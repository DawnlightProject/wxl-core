# wxl-graphics-extend.cfg -- wxl-graphics-extend user configuration.
#
# Location: Extensions\wxl-graphics-extend\wxl-graphics-extend.cfg (next to the DLL).
# Format: KEY=value, one per line. '#' or ';' starts a comment. An environment variable of the same
# name wins over this file. Booleans: 0/n/f = no, anything else = yes.
#
# Every key is shown COMMENTED with its default value: uncomment a line to take control of it.

# ----------------------------------------------------------------------------- World pass targets
# Allow redirecting the world's depth into an INTZ texture when a pass asks for it.
#WXL_GFX_DEPTH=1
# Allow the G-buffer normal target (render target 1 of the world pass) when a pass asks for it.
#WXL_GFX_NORMALS=1
# Allow the G-buffer albedo target (render target 2, beside the normals) when a pass asks for it.
#WXL_GFX_ALBEDO=1
# Allow drawing the world into an FP16 target when a pass asks for HDR.
#WXL_GFX_HDR=1

# ----------------------------------------------------------------------------- Diagnostics
# Measure every pass's GPU time with timestamp queries (shown in the overlay panel).
#WXL_GFX_PROFILE=1

# ----------------------------------------------------------------------------- Shaders
# Keep compiled shaders on disk (Extensions\wxl-graphics-extend\cache) across sessions. Each entry
# is checked against the current sources on every hit, so a stale one is never used.
#WXL_GFX_SHADER_DISK_CACHE=1

# ----------------------------------------------------------------------------- Vulkan (DXVK)
# Expose DXVK's Vulkan device to other extensions (compute passes). Without DXVK it is inert anyway;
# 0 keeps it inert on DXVK too. On Windows, DXVK is chosen in WarcraftXL.cfg (WXL_D3D9_BACKEND=dxvk).
#WXL_GFX_VULKAN=1

# ----------------------------------------------------------------------------- Baked assets
# Memory the resident baked files may hold, in MB (4..1024); the least recently used go first.
#WXL_GFX_ASSET_BUDGET_MB=64
# Read files on a worker thread (0 = on the render thread, at most two per frame).
#WXL_GFX_ASSET_ASYNC=1
